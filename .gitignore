node_modules
dist
.DS_Store
*.tsbuildinfo

# Everything fetched from a holder lives here and nowhere else: the IIIF
# manifests, the mirrored views, the tiles, the LaTeX work directory. Gallica's
# terms allow the copy for non-commercial use; they do not need us to
# redistribute it, and nothing here ever should be.
archives/

# Vendored at install time by `npm run postinstall`, from node_modules.
public/vendor/katex/

# Derived from what is on disk, and therefore different on every machine —
# regenerated by `npm run manifest`, which `npm run build` runs first.
public/manifest.json

# Reading views are derived from transcripts/*.tex by `npm run render`;
# the .tex files themselves are the source of record and are versioned.
public/transcripts/

# Belt and braces: no image of a manuscript and no PDF is versioned, anywhere.
# Facsimiles are Gallica's and are read there; compiled transcripts are rebuilt
# from their .tex. The favicon is the one SVG the site owns.
*.pdf
*.jpg
*.jpeg
*.png
*.tif
*.tiff
